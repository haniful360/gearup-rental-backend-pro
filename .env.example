# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Server Configuration
PORT=5000

# Prisma / Database
# Connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB, CockroachDB: https://pris.ly/d/connection-strings
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# Security & Password Hashing
BCRYPT_SALT_ROUNDS=10

# JWT Authentication
JWT_ACCESS_TOKEN="your_jwt_access_secret_here"
JWT_REFRESH_TOKEN="your_jwt_refresh_secret_here"
JWT_ACCESS_TOKEN_EXPIRE_IN="1h"
JWT_REFRESH_TOKEN_EXPIRE_IN="30d"

# Stripe Payments
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"
STRIPE_SUCCESS_URL="http://localhost:3000/payment/success"
STRIPE_CANCEL_URL="http://localhost:3000/payment/cancel"

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"